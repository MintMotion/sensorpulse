msgid "%(name)s has dropped to %(value)s%(unit)s (limit %(limit)s%(unit)s)."
msgstr "%(name)s desceu para %(value)s%(unit)s (limite %(limit)s%(unit)s)."

msgid "%(name)s has reached %(value)s%(unit)s (limit %(limit)s%(unit)s)."
msgstr "%(name)s chegou a %(value)s%(unit)s (limite %(limit)s%(unit)s)."

msgid "%(name)s has stopped while %(ref)s is at %(value).0f%(unit)s."
msgstr "%(name)s parou enquanto %(ref)s está a %(value).0f%(unit)s."

msgid "%(name)s is at %(value).0f%(unit)s while the computer is almost idle (%(load).0f%% load). Make sure the air vents are not blocked."
msgstr "%(name)s está a %(value).0f%(unit)s com o computador quase parado (%(load).0f%% de carga). Verifique se as grelhas de ventilação não estão tapadas."

msgid "%(name)s is at its limit (%(value).0f%(unit)s) and has to slow down a lot to protect itself. Make sure the air vents are not blocked and the fans are working."
msgstr "%(name)s está no seu limite (%(value).0f%(unit)s) e tem de abrandar muito para se proteger. Verifique se as grelhas de ventilação não estão tapadas e se as ventoinhas funcionam."

msgid "%(name)s is back to %(value)s%(unit)s."
msgstr "%(name)s voltou a %(value)s%(unit)s."

msgid "%(name)s is reducing its speed to protect itself from heat (%(value).0f%(unit)s)."
msgstr "%(name)s está a reduzir a velocidade para se proteger do calor (%(value).0f%(unit)s)."

msgid "%d custom alarm rule(s) were invalid and have been ignored."
msgstr "%d regra(s) de alarme personalizada(s) não eram válidas e foram ignoradas."

msgid "%d min"
msgstr "%d min"

msgid "%s cannot be read (check its permissions). The last good copy or the defaults are being used, and the file will not be overwritten."
msgstr "Não é possível ler %s (verifique as permissões). É usada a última cópia boa ou os valores predefinidos, e o ficheiro não será substituído."

msgid "%s could not be uninstalled. Another program may be installing updates: try again in a few minutes."
msgstr "Não foi possível desinstalar %s. Talvez outro programa esteja a instalar atualizações: tente novamente dentro de alguns minutos."

msgid "%s settings"
msgstr "Definições de %s"

msgid "--days must be between 0 and 3650"
msgstr "--days tem de estar entre 0 e 3650"

msgid "0 RPM at start: maybe nothing connected"
msgstr "0 RPM ao arrancar: talvez não haja nada ligado"

