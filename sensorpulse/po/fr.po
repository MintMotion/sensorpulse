msgid "%(name)s has dropped to %(value)s%(unit)s (limit %(limit)s%(unit)s)."
msgstr "%(name)s est descendu à %(value)s%(unit)s (limite %(limit)s%(unit)s)."

msgid "%(name)s has reached %(value)s%(unit)s (limit %(limit)s%(unit)s)."
msgstr "%(name)s a atteint %(value)s%(unit)s (limite %(limit)s%(unit)s)."

msgid "%(name)s has stopped while %(ref)s is at %(value).0f%(unit)s."
msgstr "%(name)s s'est arrêté alors que %(ref)s est à %(value).0f%(unit)s."

msgid "%(name)s is at %(value).0f%(unit)s while the computer is almost idle (%(load).0f%% load). Make sure the air vents are not blocked."
msgstr "%(name)s est à %(value).0f%(unit)s alors que l'ordinateur est presque inactif (charge %(load).0f%%). Vérifiez que les grilles d'aération ne sont pas obstruées."

msgid "%(name)s is at its limit (%(value).0f%(unit)s) and has to slow down a lot to protect itself. Make sure the air vents are not blocked and the fans are working."
msgstr "%(name)s est à sa limite (%(value).0f%(unit)s) et doit beaucoup ralentir pour se protéger. Vérifiez que les grilles d'aération ne sont pas obstruées et que les ventilateurs fonctionnent."

msgid "%(name)s is back to %(value)s%(unit)s."
msgstr "%(name)s est revenu à %(value)s%(unit)s."

msgid "%(name)s is reducing its speed to protect itself from heat (%(value).0f%(unit)s)."
msgstr "%(name)s réduit sa vitesse pour se protéger de la chaleur (%(value).0f%(unit)s)."

msgid "%d custom alarm rule(s) were invalid and have been ignored."
msgstr "%d règle(s) d'alarme personnalisée(s) n'étaient pas valides et ont été ignorées."

msgid "%d min"
msgstr "%d min"

msgid "%s cannot be read (check its permissions). The last good copy or the defaults are being used, and the file will not be overwritten."
msgstr "Impossible de lire %s (vérifiez ses permissions). La dernière copie valide ou les valeurs par défaut sont utilisées, et le fichier ne sera pas écrasé."

msgid "%s could not be uninstalled. Another program may be installing updates: try again in a few minutes."
msgstr "Impossible de désinstaller %s. Un autre programme installe peut-être des mises à jour : réessayez dans quelques minutes."

msgid "%s settings"
msgstr "Paramètres de %s"

msgid "--days must be between 0 and 3650"
msgstr "--days doit être compris entre 0 et 3650"

msgid "0 RPM at start: maybe nothing connected"
msgstr "0 tr/min au démarrage : peut-être rien de branché"

msgid "1 hour"
msgstr "1 heure"

msgid "10 min"
msgstr "10 min"

msgid "24 hours"
msgstr "24 heures"

msgid "30 days"
msgstr "30 jours"

msgid "7 days"
msgstr "7 jours"

msgid "A long interval lets the disk rest (spin down), but a disk could heat up between two readings without the alarm going off. A short interval watches it closely, but on many disks each reading stops them from going to sleep."
msgstr "Un intervalle long laisse le disque se reposer (s'arrêter), mais il pourrait chauffer entre deux lectures sans que l'alarme se déclenche. Un intervalle court le surveille de près, mais sur beaucoup de disques chaque lecture les empêche de se mettre en veille."

msgid "A sign that the air vents may be blocked or the cooling is not working well."
msgstr "Signe que les grilles d'aération sont peut-être obstruées ou que le refroidissement fonctionne mal."

msgid "A very soft glow whose color follows the state of your computer."
msgstr "Une lueur très douce dont la couleur suit l'état de votre ordinateur."

msgid "A warm disk is working, so reading it more often does not take away its rest. With the disk service (UDisks2), a disk that is asleep is not woken up to read it."
msgstr "Un disque tiède est en train de travailler : le lire plus souvent ne lui retire pas de repos. Avec le service des disques (UDisks2), un disque en veille n'est pas réveillé pour être lu."

