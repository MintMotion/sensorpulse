msgid "%(name)s has dropped to %(value)s%(unit)s (limit %(limit)s%(unit)s)."
msgstr "%(name)s ist auf %(value)s%(unit)s gefallen (Grenze %(limit)s%(unit)s)."

msgid "%(name)s has reached %(value)s%(unit)s (limit %(limit)s%(unit)s)."
msgstr "%(name)s hat %(value)s%(unit)s erreicht (Grenze %(limit)s%(unit)s)."

msgid "%(name)s has stopped while %(ref)s is at %(value).0f%(unit)s."
msgstr "%(name)s ist stehen geblieben, während %(ref)s bei %(value).0f%(unit)s liegt."

msgid "%(name)s is at %(value).0f%(unit)s while the computer is almost idle (%(load).0f%% load). Make sure the air vents are not blocked."
msgstr "%(name)s liegt bei %(value).0f%(unit)s, obwohl der Computer fast nichts tut (%(load).0f%% Last). Prüfe, ob die Lüftungsöffnungen frei sind."

msgid "%(name)s is at its limit (%(value).0f%(unit)s) and has to slow down a lot to protect itself. Make sure the air vents are not blocked and the fans are working."
msgstr "%(name)s ist an seiner Grenze (%(value).0f%(unit)s) und muss stark drosseln, um sich zu schützen. Prüfe, ob die Lüftungsöffnungen frei sind und die Lüfter laufen."

msgid "%(name)s is back to %(value)s%(unit)s."
msgstr "%(name)s ist wieder bei %(value)s%(unit)s."

msgid "%(name)s is reducing its speed to protect itself from heat (%(value).0f%(unit)s)."
msgstr "%(name)s drosselt seine Geschwindigkeit, um sich vor Hitze zu schützen (%(value).0f%(unit)s)."

msgid "%d custom alarm rule(s) were invalid and have been ignored."
msgstr "%d eigene Alarmregel(n) waren ungültig und wurden ignoriert."

msgid "%d min"
msgstr "%d min"

msgid "%s cannot be read (check its permissions). The last good copy or the defaults are being used, and the file will not be overwritten."
msgstr "%s kann nicht gelesen werden (prüfe die Berechtigungen). Es wird die letzte gute Kopie oder die Voreinstellung verwendet, und die Datei wird nicht überschrieben."

msgid "%s could not be uninstalled. Another program may be installing updates: try again in a few minutes."
msgstr "%s konnte nicht deinstalliert werden. Vielleicht installiert gerade ein anderes Programm Aktualisierungen: versuche es in ein paar Minuten erneut."

msgid "%s settings"
msgstr "Einstellungen von %s"

msgid "--days must be between 0 and 3650"
msgstr "--days muss zwischen 0 und 3650 liegen"

